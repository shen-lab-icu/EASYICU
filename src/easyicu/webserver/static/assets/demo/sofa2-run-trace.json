    ],
    "application": "Treat phenotype classification as determined over the prespecified first 24 hours after ICU admission and keep interpretation limited to the resulting descriptive landmark population.",
    "application_zh": "表型按入 ICU 后预先规定的前 24 小时判定，解读只限于由此得到的描述性 landmark 人群。",
    "divergence": "No landmark survival estimator is fitted; the source informs temporal alignment of the descriptive classification.",
    "divergence_zh": "没有拟合 landmark 生存估计；这篇文献只用于对齐描述性分类的时间。"
   },
   {
    "step_id": "03_exposure_outcome_distribution",
    "key": "suissa_immortal_time_2008",
    "elements": [
     "time_zero",
     "exposure",
     "estimand"
    ],
    "application": "Flag the post-ICU-admission exposure-ascertainment period as a limitation and avoid interpreting the grouped mortality proportions as ordinary baseline exposure effects.",
    "application_zh": "把入 ICU 后才确定暴露的这段时间标为局限，不把分组死亡比例解读为普通的基线暴露效应。",
    "divergence": "No causal or time-to-event effect estimate is attempted.",
    "divergence_zh": "不做因果或时间-事件效应估计。"
   }
