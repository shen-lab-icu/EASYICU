{
  "schema_version": "easyicu.dev9_comparator_shadow_review/1",
  "protocol_ref": "easyicu.dev9_comparator_shadow_review/20260825-v2",
  "audience": "evaluator_only",
  "agent_visibility": "forbidden_before_execution",
  "purpose": "Use representative high-quality studies as external method and presentation anchors after each exact-head Dev9 run.",
  "use_policy": {
    "allowed": [
      "study_design_completeness",
      "method_and_diagnostic_completeness",
      "table_and_figure_completeness",
      "claim_boundary_calibration"
    ],
    "forbidden": [
      "numeric_gold_answer",
      "expected_effect_direction",
      "result_similarity_pass_fail",
      "copying_source_specific_definitions_without_justification",
      "copying_a_fixed_figure_template"
    ]
  },
  "dimensions": [
    "study_population",
    "time_zero_and_windows",
    "variable_operationalization",
    "missingness_and_censoring",
    "primary_model_and_sensitivities",
    "table_and_figure_completeness",
    "conclusion_boundaries"
  ],
  "review_states": [
    "meets_anchor",
    "stronger_than_anchor",
    "actionable_gap",
    "not_applicable",
    "fail_closed_appropriate"
  ],
  "required_review_fields": [
    "run_head",
    "run_image",
    "run_path",
    "dimension",
    "state",
    "run_evidence_paths",
    "gap_or_rationale",
    "owner_module",
    "next_action",
    "supports",
    "cannot_prove"
  ],
  "acceptance_rule": "Every dimension must have run-bound evidence and no unowned actionable gap. A scientifically justified fail-closed result is acceptable and must not be converted into a synthetic estimate. Comparator agreement in magnitude or direction is never an acceptance condition.",
  "anchor_access_policy": {
    "full_text_required_for_every_anchor": true,
    "supplement_handling": "record_and_review_if_published",
    "inaccessible_anchor_action": "replace_anchor"
  },
