{
  "schema_version": "easyicu.case_cohort_patterns/1",
  "case_id": "case_b_sofa2_sepsis",
  "patterns": {
    "sepsis3_at_admission": {
      "provenance": "Case B protocol. Operationalizes Sepsis-3 as suspected infection plus SOFA >= 2 in an admission-anchored ICU window; see Singer et al., JAMA 2016, and EasyICU concepts susp_inf and sofa.",
      "definition": {
        "name": "sepsis3_at_admission",
        "inclusion": [
          {
            "concept_id": "susp_inf",
            "time_window": {
              "anchor": "icu_admit",
              "start_offset_hours": -24,
              "end_offset_hours": 24
            },
            "aggregation": "any",
            "op": "==",
            "value": true
          },
          {
            "concept_id": "sofa",
            "time_window": {
              "anchor": "icu_admit",
              "start_offset_hours": 0,
              "end_offset_hours": 24
            },
            "aggregation": "max",
            "op": ">=",
            "value": 2
          }
        ],
        "exclusion": []
      }
    },
    "sofa2_admission_window": {
